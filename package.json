    "validate:multimedia": "node scripts/validate-multimedia.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "typescript": "5.9.3"
